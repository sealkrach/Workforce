# Fournisseur LLM compatible OpenAI (OpenAI, Azure, Ollama, vLLM, LM Studio, OpenRouter...)
# Sans LLM_API_KEY, l'application démarre en mode "mock" (analyseur local simplifié).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Transcription vocale de secours (navigateurs sans reconnaissance vocale native)
STT_MODEL=whisper-1
PORT=3000

# Réseau : par défaut le serveur n'écoute que sur cette machine (127.0.0.1).
# Pour l'ouvrir à l'équipe sur le réseau interne : HOST=0.0.0.0 (voir README, section Déploiement).
# HOST=0.0.0.0
# Charger les données de démonstration au démarrage d'une base VIDE (jamais sur une base existante)
# SEED_DEMO=1
# Emplacement de la base (par défaut : data/workforce.db dans le dossier du projet)
# DB_PATH=/chemin/vers/workforce.db

# --- Connexion (OpenID Connect) : laisser vide pour désactiver l'authentification ---
# PUBLIC_URL=https://workforce.entreprise.fr
# KEYCLOAK_ISSUER=https://sso.entreprise.fr/realms/entreprise
# KEYCLOAK_CLIENT_ID=workforce
# KEYCLOAK_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ALLOWED_EMAIL_DOMAINS=entreprise.fr
# ADMIN_EMAILS=prenom.nom@entreprise.fr
# SESSION_DAYS=14
# Derrière un reverse proxy : ALLOWED_HOSTS=workforce.entreprise.fr  (et TRUST_PROXY=1 si le proxy réécrit Host)

# --- Intégration SmartUC (registre des use cases IA, connexion MCP en lecture seule) ---
# SMARTUC_MCP_URL=https://smartuc.entreprise.fr/mcp
# SMARTUC_API_KEY=uch_...                  # SmartUC › MCP & API › Create key ; compte « reviewer » ou « admin » recommandé
# SMARTUC_PUBLIC_URL=https://smartuc.entreprise.fr   # liens « Ouvrir dans SmartUC » (par défaut : l'origine de l'URL MCP)
# SMARTUC_POLL_MINUTES=5
